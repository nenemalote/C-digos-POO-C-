int main() {
    // TODO: Implementa el main aquí...
    vector <Vehiculo*> vehiculos;
    vehiculos.push_back(new Auto("Toyota", 200.0, 60000));
    vehiculos.push_back(new Moto("Yamaha", 100.0, 600));
    vehiculos.push_back(new Camion("Volvo", 500.0, 10));
    for(int i=0; i<vehiculos.size(); i++){
        cout << "---REGISTRO---" << endl;
        vehiculos[i]->mostrarReporte();
    }
    cout << "---REGISTRO DEL Vehiculo mas costoso--- " << endl;
    vehiculoMantenimientoMasCostoso(vehiculos)->mostrarReporte();
    for(int i=0; i<vehiculos.size(); i++){
        delete vehiculos[i];
    }
    return 0;
}
