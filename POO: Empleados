 * 5. Método virtual puro (= 0):
 *    - double calcularSalarioTotal() const
 * 6. Método virtual:
 *    - void mostrarDetalle() const
 *      Imprime en consola:
 *      - Nombre del empleado
 *      - Salario base
 *      - Salario total (invocando a calcularSalarioTotal())
 */
 class Empleado{
    protected:
    string nombre;
    double salarioBase;
    public:
    Empleado(const string&nombre, double salarioBase) : nombre(nombre), salarioBase(salarioBase){
        
    }
    virtual ~Empleado() = default;
    virtual double calcularSalarioTotal() const = 0;
    virtual void mostrarDetalle() const{
        cout << "---REGISTRO---" << endl;
        cout << "Nombre del empleado: " << nombre << endl;
        cout << "Salario base: " << salarioBase << endl;
        cout << "Salario total: " << calcularSalarioTotal() << endl;
        cout << endl;
    }
 };

