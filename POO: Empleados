/*
 * INSTRUCCIONES - Función empleadoMejorPagado:
 * Firma: Empleado* empleadoMejorPagado(const vector<Empleado*>& empleados)
 * 1. Asume que el primer empleado del vector es el mejor pagado (Empleado* mejor = empleados[0]).
 * 2. Recorre el vector desde el índice 1 hasta empleados.size() - 1.
 * 3. Compara si el salario total (calcularSalarioTotal()) del elemento actual
 *    es MAYOR que el salario total del empleado guardado en 'mejor'.
 * 4. Si es mayor, actualiza la variable 'mejor'.
 * 5. Retorna el puntero 'mejor'.
 */

// TODO: Implementa la función empleadoMejorPagado aquí...
Empleado* empleadoMejorPagado(const vector<Empleado*>& empleados){
    Empleado* mejor = empleados[0];
    for(int i=0; i<empleados.size(); i++){
        if(empleados[i]->calcularSalarioTotal()>mejor->calcularSalarioTotal()){
            mejor = empleados[i];
        }
    }
    return mejor;
}

