// TODO: Implementa la clase EmpleadoTiempoCompleto aquí...
class EmpleadoTiempoCompleto : public Empleado{
    private:
    double bonoAnual;
    public:
    EmpleadoTiempoCompleto(string nombre, double salarioBase, double bonoAnual) : Empleado(nombre, salarioBase), bonoAnual(bonoAnual){
        
    }
