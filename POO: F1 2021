// 4. FUNCIÓN AUXILIAR: campeonTemporada
// Firma: PilotoF1* campeonTemporada(const vector<PilotoF1*>& parrilla, int podiosComunes)
// Retorna el puntero al piloto con mayor cantidad de puntos totales
// ==========================================

// TODO: Implementa la función auxiliar aquí...
PilotoF1* campeonTemporada(const vector <PilotoF1*>& parrilla, int podiosComunes){
    PilotoF1* masGanador = parrilla[0];
    for(int i=0; i<parrilla.size(); i++){
        if(parrilla[i]->calcularPuntosTotales(podiosComunes)>masGanador->calcularPuntosTotales(podiosComunes)){
            masGanador = parrilla[i];
        }
    }
    return masGanador;
}

