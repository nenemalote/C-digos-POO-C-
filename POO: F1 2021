// Atributo privado: int vueltasRapidas
// Constructor: (nombre, escuderia, victorias, vueltasRapidas)
// Regla: puntos = (victorias * 25) + (podiosSinVictoria * 18) + (vueltasRapidas * 1)
// ==========================================

// TODO: Implementa la clase PilotoTitular aquí...
class PilotoTitular : public PilotoF1{
  private:
  int vueltasRapidas;
  public:
  PilotoTitular(string n, string e, int v, int vueltas) : PilotoF1(n, e, v), vueltasRapidas(vueltas){
      
  }
  int calcularPuntosTotales(int podiosSinVictoria) const override{
      return (victorias*25)+(podiosSinVictoria*18)+(vueltasRapidas*1);
  }
};


